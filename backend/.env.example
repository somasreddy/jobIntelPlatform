# --- Database (Neon.tech Recommended for Vercel) ---
DATABASE_URL=postgresql+asyncpg://user:pass@ep-hostname.region.aws.neon.tech/neondb

# --- Redis (Upstash Recommended for Vercel Serverless) ---
# Example: rediss://default:your-password@your-endpoint.upstash.io:6379
REDIS_URL=redis://localhost:6379/0

# --- LLM API Keys ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
PERPLEXITY_API_KEY=

# New Alternative Providers
MISTRAL_API_KEY=
COHERE_API_KEY=
TOGETHER_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
HUGGINGFACE_API_KEY=

# --- Default Models ---
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
OPENAI_MODEL=gpt-4o
GOOGLE_MODEL=gemini-2.0-flash
GROQ_MODEL=llama-3.3-70b-versatile
MISTRAL_MODEL=mistral-small-latest
COHERE_MODEL=command-r
TOGETHER_MODEL=meta-llama/Llama-3-70b-chat-hf
DEEPSEEK_MODEL=deepseek-chat
OPENROUTER_MODEL=mistralai/mistral-7b-instruct:free
HUGGINGFACE_MODEL=Qwen/Qwen2.5-72B-Instruct

# --- Fallback Strategy ---
LLM_FALLBACK_ORDER=groq,deepseek,mistral,openrouter,openai,anthropic,google

# --- Feature Flags ---
CONSOLIDATED_MODE=true

# --- Job Discovery API Keys ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JSEARCH_API_KEY=

# --- CORS Origins (Add your Vercel frontend URL here) ---
CORS_ORIGINS=["http://localhost:3000", "https://your-app.vercel.app"]

# --- Auth ---
# Deployment environment ("development" default, or "staging"/"production"). If left as
# development the app only warns about insecure auth defaults; in staging/production it
# refuses to start unless JWT_SECRET_KEY has been changed from its built-in default.
APP_ENV=development
# Secret used to sign/verify JWTs. Leaving this unset uses an insecure, publicly-known
# default — anyone can forge valid tokens. MUST be set to a long random value in staging/production.
JWT_SECRET_KEY=
# When true, requests without a valid Bearer token are rejected (401). When false/unset,
# unauthenticated requests silently fall back to a hardcoded demo user — fine for local
# dev, but means auth is effectively optional. Set to true outside local development.
REQUIRE_AUTH=false

# =============================================================================
# --- SSO, Email, and Calendar scaffolding (core/sso.py, core/email_service.py,
#     core/calendar_service.py) ---
#
# NONE OF THESE THREE INTEGRATIONS ARE LIVE. They are honest interface-only
# scaffolding: clean abstractions with exactly one stub implementation each,
# not wired into any router, that make it obvious where a real integration
# would be plugged in later. Every var below is intentionally left blank —
# there is no real identity-provider tenant, email-sending account, or
# calendar OAuth app registered anywhere for this project in this
# environment. Leaving them unset is the correct, honest state; setting them
# is a deliberate future decision for whoever chooses and configures a real
# provider (this is NOT something to fill in speculatively).
# =============================================================================

# --- SSO / OIDC (backend/core/sso.py) ---
# GenericOIDCProvider raises a clear SSONotConfiguredError until ALL THREE
# of these are set to real values from an actual identity-provider tenant
# (Okta, Auth0, Azure AD / Microsoft Entra ID, Google Workspace, OneLogin,
# Keycloak, etc — any standard OIDC provider works, none is preferred).
# Even once set, the authorization-code exchange itself
# (GenericOIDCProvider.exchange_code) still needs to be implemented — see
# the NotImplementedError message in core/sso.py for what that involves.
SSO_OIDC_ISSUER=
SSO_OIDC_CLIENT_ID=
SSO_OIDC_CLIENT_SECRET=

# --- Transactional email (backend/core/email_service.py) ---
# LoggingEmailService (the only implementation shipped) always logs the
# email content instead of sending it, regardless of whether this is set —
# a real provider call still needs to be implemented (SendGrid, Postmark,
# and Amazon SES are common picks; none is wired here). Distinct from the
# SENDGRID_API_KEY / RESEND_API_KEY / SMTP_* vars used by the *existing*,
# already-functional morning-digest feature (services/digest.py) — this is
# separate, unrelated scaffolding for other future transactional email.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=

# --- Calendar integration (backend/core/calendar_service.py) ---
# LoggingCalendarService (the only implementation shipped) always logs the
# would-be event instead of creating it, regardless of whether this is set.
# Activating real event creation requires registering an OAuth app with a
# calendar provider (Google Calendar, Microsoft Graph/Outlook, Cronofy,
# etc — none is implemented here) and then writing the real OAuth + API call.
CALENDAR_OAUTH_CLIENT_ID=
CALENDAR_OAUTH_CLIENT_SECRET=
CALENDAR_OAUTH_REDIRECT_URI=
